<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Lux</string>
    <key>CFBundleName</key>
    <string>Lux</string>
    <key>NSCameraUsageDescription</key>
    <string>Lux briefly requests camera access when TCP connectivity is enabled so WebRTC can negotiate TCP candidates. Camera video is not retained.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Lux connects to remote desktop hosts that you specify, including hosts on your local network.</string>
    <key>UIRequiresFullScreen</key>
    <true/>
    <key>UIDeviceFamily</key>
    <array>
        <integer>2</integer>
    </array>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <key>GCSupportsControllerUserInteraction</key>
    <true/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
</dict>
</plist>
